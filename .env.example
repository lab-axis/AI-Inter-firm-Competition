# ==============================================================================
# Root environment variables (example) — fill in the values and copy to `.env`.
#   cp .env.example .env
# `.env` is ignored by .gitignore and must never be committed. Never commit real keys.
# ==============================================================================

# ── External API keys (data collection) ───────────────────────
GITHUB_TOKEN=
HF_TOKEN=
EODHD_API_KEY=
SEC_API_KEY=
FINNHUB_API_KEY=

# ── Neo4j (graph DB) ───────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Embedding server (vLLM / OpenAI-compatible endpoint) ───────
EMBED_URL=http://localhost:8000/v1/embeddings
EMBED_MODEL=jinaai/jina-embeddings-v3
