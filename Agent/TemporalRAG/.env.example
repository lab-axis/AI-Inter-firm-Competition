# TemporalRAG Environment Configuration
# Copy this file to .env and fill in your values

# ──────────────────────────────
# API Server Settings
# ──────────────────────────────
HOST=0.0.0.0
PORT=8002
DEBUG=False
LOG_LEVEL=info

# ──────────────────────────────
# Security
# ──────────────────────────────
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ──────────────────────────────
# Neo4j Graph Database
# ──────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ──────────────────────────────
# vLLM Servers (OpenAI-compatible)
# ──────────────────────────────
# Embedding server
VLLM_EMBEDDING_URL=http://localhost:8000/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# LLM server (DeepSeek-R1)
VLLM_LLM_URL=http://localhost:8001/v1/chat/completions
LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# ──────────────────────────────
# CORS (comma-separated origins for production)
# ──────────────────────────────
CORS_ORIGINS=*
